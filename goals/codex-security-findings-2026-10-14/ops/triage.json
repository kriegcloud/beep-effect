      "id": "CSF-001",
      "codexId": "commit:4219f7291acc8191aab10fe5ae352a3c",
      "title": "Crafted review counts can crash Yeet closeout and monitoring",
      "severity": "Medium",
      "codexStatus": "New",
      "commit": "661e0932de3a5a04797bfa4d6a80552f317429cf",
      "disposition": "remediate",
      "validation": {
        "status": "complete",
        "confidence": "high",
        "rationale": "Security Cloud validation and attack-path analysis identify a public PR review body whose oversized Greptile count reaches S.Finite through the Yeet parser. Current HEAD still parsed decimal captures without a safe-integer bound or saturated aggregate; the focused regression reproduces the input and passes after repair."
      },
      "remediation": {
        "status": "implemented",
        "changedFiles": [
          "packages/tooling/tool/cli/src/commands/Yeet/internal/ReviewBodySignal.ts",
          "packages/tooling/tool/cli/test/yeet-review-body-signal.test.ts"
        ],
        "verificationCommands": [
          "bunx vitest run test/yeet-review-body-signal.test.ts --pool=threads --maxWorkers=1"
        ],
        "summary": "Saturate untrusted review counts and aggregates at a finite ceiling before checked schema construction; retain advisory visibility."
      },
      "verdict": "confirmed-vulnerable",
      "ownerArea": "Yeet review body parsing",
      "lane": "L1"
    },
