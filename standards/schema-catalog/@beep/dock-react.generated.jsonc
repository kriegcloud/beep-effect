    {"file":"packages/foundation/ui-system/dock-react/src/internal/Gesture.models.ts","symbol":"SashDragBase","kind":"schema-class","owner":"@beep/dock-react","identity":"SashDragBase","description":"Shared state captured while resizing a split sash, including the captured pointer identity so cancellation can release the real capture (synthetic pointercancel events carry a default pointerId, not the captured one)."},
