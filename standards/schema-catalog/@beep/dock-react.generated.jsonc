    {"file":"packages/foundation/ui-system/dock-react/src/internal/Gesture.models.ts","symbol":"TabRect","kind":"struct-const","owner":"@beep/dock-react","identity":"TabRect","description":"Root-relative horizontal geometry of one rendered tab, measured from the DOM. Drop targeting uses these instead of group-box arithmetic: the strip's padding and gaps are invisible to the box, and overflowed tabs have no rect at all."}
