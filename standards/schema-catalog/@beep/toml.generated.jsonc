    {"file":"packages/foundation/modeling/toml/src/TomlEdit.ts","symbol":"TomlEdit","kind":"struct-const","owner":"@beep/toml","identity":"TomlEdit","description":"A non-mutating text edit: replace the span `[offset, offset + length)` with `content`. Set `length` to `0` to insert, `content` to `\"\"` to delete."},
    {"file":"packages/foundation/modeling/toml/src/TomlEdit.ts","symbol":"TomlRange","kind":"struct-const","owner":"@beep/toml","identity":"TomlRange","description":"A range within a TOML document, expressed as a zero-based character `offset` and a `length` in UTF-16 code units. Pass to `TomlFormat.format` to restrict formatting to the expressions intersecting a region."},
