{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    ":separateMajorReleases",
    ":automergeMinor",
    ":automergeDigest",
    "schedule:weekends"
  ],
  "labels": ["dependencies"],
  "rangeStrategy": "bump",
  "bun": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Group Effect ecosystem updates",
      "matchPackagePatterns": ["^effect", "^@effect/"],
      "groupName": "Effect ecosystem",
      "automerge": false
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": true
    },
    {
      "description": "Group Biome updates",
      "matchPackagePatterns": ["^@biomejs/"],
      "groupName": "Biome",
      "automerge": true
    },
    {
      "description": "Group test tooling updates",
      "matchPackageNames": ["vitest", "@vitest/coverage-v8", "@effect/vitest"],
      "groupName": "Test tooling",
      "automerge": false
    },
    {
      "description": "Auto-merge type definition updates",
      "matchPackagePatterns": ["^@types/"],
      "automerge": true
    },
    {
      "description": "One update PR per vendored skill (B18), so one conflict never stalls the others. The skills update train workflow replays, relocks, and proves each one; nothing automerges (B28).",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["skills-lock.json"],
      "groupName": "skill {{depName}}",
      "labels": ["dependencies", "skills-update-train"],
      "automerge": false
    }
  ],
  "ignorePaths": [".repos/**"],
  "gitIgnoredAuthors": [
    "41898282+github-actions[bot]@users.noreply.github.com"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Vendored skill pins in skills-lock.json (B3, B18): each vendored entry's upstream.repository and upstream.sourceRevision, tracked on upstream.trackingRef through git-refs. Local entries carry no upstream block, so they never match.",
      "managerFilePatterns": ["/^skills-lock\\.json$/"],
      "matchStrings": [
        "\"(?<depName>[a-z0-9][a-z0-9-]*)\": \\{\\s*\"_tag\": \"vendored\",\\s*\"sourceType\": \"github\",\\s*\"upstream\": \\{\\s*\"repository\": \"(?<repository>[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)\",\\s*\"repositoryUrl\": \"[^\"]+\",\\s*\"treePath\": \"[^\"]+\",\\s*\"entryPath\": \"[^\"]+\",\\s*\"trackingRef\": \"(?<currentValue>[^\"]+)\",\\s*\"sourceRevision\": \"(?<currentDigest>[0-9a-f]{40})\""
      ],
      "datasourceTemplate": "git-refs",
      "packageNameTemplate": "https://github.com/{{{repository}}}"
    }
  ]
}
