--- a/util/deep-ignore.js
+++ b/util/deep-ignore.js
@@ -0,0 +1,117 @@
+/**
+ * Local patch (2026-09-25): a committed, repo-level ignore list for the meaning
+ * tier. `<root>/.graftignore` names files the LLM passes must never spend a
+ * call on (generated code, vendored blobs): the crux pass marks their symbols
+ * `excluded` instead of `pending`/`stale`, and the concept pass neither
+ * summarizes nor coverage-checks them. The structural (tree-sitter) graph is
+ * untouched, so `graft grep` / `graft callers` still see every symbol.
+ *
+ * Syntax is a gitignore subset: one pattern per line, `#` comments, `*` (one
+ * segment), `**` (any depth), `?`; a pattern with no leading `/` matches at any
+ * depth; a trailing `/` or `/**` matches everything under a directory.
+ */
+import { readFileSync } from "node:fs";
+import { join } from "node:path";
+import { contentHash } from "./id.js";
+export const DEEP_IGNORE_FILE = ".graftignore";
+function toMatcher(pattern) {
+    let p = pattern.trim();
+    const anchored = p.startsWith("/");
+    if (anchored)
+        p = p.slice(1);
+    if (p.endsWith("/"))
+        p = `${p}**`;
+    const compile = (value) => {
+        const tokens = [];
+        if (!anchored && !value.startsWith("**"))
+            tokens.push("depth");
+        for (let i = 0; i < value.length; i++) {
+            const c = value[i];
+            if (c === "*" && value[i + 1] === "*") {
+                if (value[i + 2] === "/") {
+                    tokens.push("depth");
+                    i += 2;
+                }
+                else {
+                    tokens.push("globstar");
+                    i++;
+                }
+            }
+            else if (c === "*")
+                tokens.push("star");
+            else if (c === "?")
+                tokens.push("question");
+            else
+                tokens.push(c);
+        }
+        return (rel) => {
+            const width = rel.length + 1;
+            const memo = new Map();
+            const match = (tokenIndex, pathIndex) => {
+                const key = tokenIndex * width + pathIndex;
+                if (memo.has(key))
+                    return memo.get(key);
+                if (tokenIndex === tokens.length)
+                    return pathIndex === rel.length;
+                const token = tokens[tokenIndex];
+                const remaining = pathIndex < rel.length;
+                const character = rel[pathIndex];
+                let matched;
+                if (token === "globstar")
+                    matched = match(tokenIndex + 1, pathIndex) || (remaining && match(tokenIndex, pathIndex + 1));
+                else if (token === "depth")
+                    matched = ((pathIndex === 0 || rel[pathIndex - 1] === "/") && match(tokenIndex + 1, pathIndex)) ||
+                        (remaining && match(tokenIndex, pathIndex + 1));
+                else if (token === "star")
+                    matched = match(tokenIndex + 1, pathIndex) || (remaining && character !== "/" && match(tokenIndex, pathIndex + 1));
+                else if (token === "question")
+                    matched = remaining && character !== "/" && match(tokenIndex + 1, pathIndex + 1);
+                else
+                    matched = remaining && character === token && match(tokenIndex + 1, pathIndex + 1);
+                memo.set(key, matched);
+                return matched;
+            };
+            return match(0, 0);
+        };
+    };
+    // A trailing `/**` (also produced by a trailing `/`) includes the directory
+    // itself and every descendant, without matching a similarly named sibling.
+    const variants = p.endsWith("/**") ? [p.slice(0, -3), p] : [p];
+    const matchers = variants.map(compile);
+    return (rel) => matchers.some((matches) => matches(rel));
+}
+/** Parse ignore-file text into a matcher over repo-relative POSIX paths. */
+export function compileDeepIgnore(text) {
+    const rules = text
+        .split("\n")
+        .map((line) => line.trim())
+        .filter((line) => line !== "" && !line.startsWith("#"))
+        .map(toMatcher);
+    if (rules.length === 0)
+        return () => false;
+    return (rel) => rules.some((rule) => rule(rel));
+}
+/** The text of `<root>/.graftignore`, or null when there is none. A file that
+ * exists but cannot be read is an error: silently ignoring nothing would send
+ * every listed file back through the LLM passes. */
+export function readDeepIgnoreText(root) {
+    try {
+        return readFileSync(join(root, DEEP_IGNORE_FILE), "utf8");
+    }
+    catch (err) {
+        if (err && typeof err === "object" && err.code === "ENOENT")
+            return null;
+        throw err;
+    }
+}
+/** The matcher for `<root>/.graftignore`; a missing file ignores nothing. */
+export function readDeepIgnore(root) {
+    const text = readDeepIgnoreText(root);
+    return text === null ? () => false : compileDeepIgnore(text);
+}
+/** Content hash of the rule file, recorded in the graph fingerprint so a rule
+ * change alone counts as drift; null when there is no file. */
+export function deepIgnoreHash(root) {
+    const text = readDeepIgnoreText(root);
+    return text === null ? null : contentHash(text);
+}
