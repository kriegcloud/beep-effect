language js

// URL.pathname preserves percent escapes and does not produce native Windows paths.
or {
  `new URL($path, import.meta.url).pathname`,
  `new URL(import.meta.url).pathname`
} as $access where {
  register_diagnostic(span=$access, message="Rule: file URL pathname. Why: pathname is URL-encoded, not a native filesystem path. Fix: use fileURLToPath(new URL(...)) from node:url or the Effect Path API.", severity="error")
}
