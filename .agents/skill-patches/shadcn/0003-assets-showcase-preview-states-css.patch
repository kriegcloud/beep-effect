diff --git a/assets/showcase/preview-states.css b/assets/showcase/preview-states.css
new file mode 100644
index 000000000000..8d9e3cec24dd
--- /dev/null
+++ b/assets/showcase/preview-states.css
@@ -0,0 +1,14 @@
+/* Add to the app's global CSS after the dark variant. */
+/* Lets the design system page pin interaction states with data-preview="hover focus active". */
+@custom-variant hover {
+  @media (hover: hover) {
+    &:hover {
+      @slot;
+    }
+  }
+  &[data-preview~="hover"] {
+    @slot;
+  }
+}
+@custom-variant focus-visible (&:focus-visible, &[data-preview~="focus"]);
+@custom-variant active (&:active, &[data-preview~="active"]);
